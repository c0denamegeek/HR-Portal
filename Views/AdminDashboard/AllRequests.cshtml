@model IEnumerable<HR_Portal.Models.Domain.LeaveRequest>
@{
    ViewData["Title"] = "All Requests";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span><i class="bi bi-list-check me-2"></i>All Leave Requests</span>
        <form method="get" class="d-flex gap-2 flex-wrap">
            <select name="department" class="form-select form-select-sm" style="width:auto;" onchange="this.form.submit()">
                <option value="">All Departments</option>
                @foreach (var d in (IEnumerable<string?>)ViewBag.Departments)
                {
                    <option value="@d" selected="@(ViewBag.SelectedDept == d)">@d</option>
                }
            </select>
            <select name="status" class="form-select form-select-sm" style="width:auto;" onchange="this.form.submit()">
                <option value="">All Statuses</option>
                @foreach (var s in Enum.GetValues<HR_Portal.Models.Enums.LeaveStatus>())
                {
                    <option value="@s" selected="@(ViewBag.SelectedStatus?.ToString() == s.ToString())">@s</option>
                }
            </select>
            <select name="year" class="form-select form-select-sm" style="width:auto;" onchange="this.form.submit()">
                @for (int y = DateTime.Today.Year; y >= DateTime.Today.Year - 3; y--)
                {
                    <option value="@y" selected="@(ViewBag.SelectedYear == y)">@y</option>
                }
            </select>
        </form>
    </div>

    <div class="card-body p-0">
        @if (Model.Any())
        {
            <table class="table table-hover mb-0">
                <thead style="background:#f8fafc;font-size:.8125rem;color:#64748b;">
                    <tr>
                        <th class="px-4 py-3">Employee</th>
                        <th class="py-3">Department</th>
                        <th class="py-3">Leave Type</th>
                        <th class="py-3">Start</th>
                        <th class="py-3">End</th>
                        <th class="py-3">Days</th>
                        <th class="py-3">Status</th>
                        <th class="py-3">Approver</th>
                        <th class="py-3">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="px-4 py-3">
                                <div style="font-weight:600;">@r.Employee.Name @r.Employee.Surname</div>
                                <div style="font-size:.8rem;color:#94a3b8;">@r.Employee.Email</div>
                            </td>
                            <td class="py-3" style="color:#64748b;">@(r.Employee.Department ?? "-")</td>
                            <td class="py-3">@r.LeaveType.Name</td>
                            <td class="py-3">@r.StartDate.ToString("dd MMM yyyy")</td>
                            <td class="py-3">@r.EndDate.ToString("dd MMM yyyy")</td>
                            <td class="py-3">@r.TotalDays</td>
                            <td class="py-3">
                                <span class="status-badge status-@r.Status.ToString().ToLower()">@r.Status</span>
                            </td>
                            <td class="py-3" style="font-size:.875rem;color:#64748b;">
                                @if (r.Approver is not null)
                                {
                                    @($"{r.Approver.Name} {r.Approver.Surname}")
                                }
                                else if (r.Employee.IsManager)
                                {
                                    <span class="badge bg-primary">Admin Queue</span>
                                }
                                else
                                {
                                    <span style="color:#DC2626;">Unassigned</span>
                                }
                            </td>
                            <td class="py-3">
                                @if (r.Status == HR_Portal.Models.Enums.LeaveStatus.Pending && r.ApproverId == null)
                                {
                                    <a asp-action="ReviewRequest" asp-route-id="@r.Id"
                                       class="btn btn-sm btn-primary">Review</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5" style="color:#94a3b8;">
                <i class="bi bi-inbox" style="font-size:2rem;"></i>
                <p class="mt-2 mb-0">No requests found</p>
            </div>
        }
    </div>
</div>

@model HR_Portal.ViewModel.AdminViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

@* ── Stat cards ───────────────────────────────────────────────────────────── *@
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="stat-card" style="background:linear-gradient(135deg,#2563EB,#1D4ED8)">
            <div class="stat-label">Total Employees</div>
            <div class="stat-value">@Model.TotalUsers</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="stat-card" style="background:linear-gradient(135deg,#D97706,#B45309)">
            <div class="stat-label">Pending Requests</div>
            <div class="stat-value">@Model.TotalPending</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="stat-card" style="background:linear-gradient(135deg,#16A34A,#15803D)">
            <div class="stat-label">Approved This Year</div>
            <div class="stat-value">@Model.TotalApproved</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="stat-card" style="background:linear-gradient(135deg,#7C3AED,#6D28D9)">
            <div class="stat-label">On Leave Today</div>
            <div class="stat-value">@Model.EmployeesOnLeaveToday</div>
        </div>
    </div>
</div>

@* ── Recent requests ──────────────────────────────────────────────────────── *@
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-list-check me-2"></i>Recent Requests</span>
        <a asp-action="AllRequests" class="btn btn-outline-primary btn-sm">View All</a>
    </div>
    <div class="card-body p-0">
        @if (Model.RecentRequests.Any())
        {
            <table class="table table-hover mb-0">
                <thead style="background:#f8fafc;font-size:.8125rem;color:#64748b;">
                    <tr>
                        <th class="px-4 py-3">Employee</th>
                        <th class="py-3">Department</th>
                        <th class="py-3">Leave Type</th>
                        <th class="py-3">Dates</th>
                        <th class="py-3">Days</th>
                        <th class="py-3">Status</th>
                        <th class="py-3">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.RecentRequests)
                    {
                        <tr>
                            <td class="px-4 py-3">
                                <div style="font-weight:600;">@r.Employee.Name @r.Employee.Surname</div>
                                <div style="font-size:.8rem;color:#94a3b8;">@r.Employee.Email</div>
                            </td>
                            <td class="py-3" style="color:#64748b;">@(r.Employee.Department ?? "-")</td>
                            <td class="py-3">@r.LeaveType.Name</td>
                            <td class="py-3" style="font-size:.875rem;">
                                @r.StartDate.ToString("dd MMM") – @r.EndDate.ToString("dd MMM yyyy")
                            </td>
                            <td class="py-3">@r.TotalDays</td>
                            <td class="py-3">
                                <span class="status-badge status-@r.Status.ToString().ToLower()">@r.Status</span>
                            </td>
                            <td class="py-3">
                                @if (r.Status == HR_Portal.Models.Enums.LeaveStatus.Pending && r.ApproverId == null)
                                {
                                    <a asp-action="ReviewRequest" asp-route-id="@r.Id"
                                       class="btn btn-sm btn-primary">Review</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5" style="color:#94a3b8;">
                <i class="bi bi-inbox" style="font-size:2rem;"></i>
                <p class="mt-2 mb-0">No requests yet</p>
            </div>
        }
    </div>
</div>

@model IEnumerable<HR_Portal.Models.Domain.Users>
@{
    ViewData["Title"] = "Leave History";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span><i class="bi bi-clock-history me-2"></i>Leave History</span>

        <form method="get" class="d-flex gap-2 flex-wrap">

            @* Search *@
            <div class="input-group input-group-sm">
                <input type="text" name="search" value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Search"
                       style="min-width:200px;" />
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search"></i></button>
            </div>

            @if (!string.IsNullOrEmpty(ViewBag.Search as string) || !string.IsNullOrEmpty(ViewBag.SelectedDept as string))
            {
                <a asp-action="LeaveHistory" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-search"></i>Clear
                </a>
            }
        </form>
    </div>

    <div class="card-body p-0">
        @if (Model.Any())
        {
            <table class="table table-hover mb-0">
                <thead style="background:#f8fafc;font-size:.8125rem;color:#64748b;">
                    <tr>
                        <th class="px-4 py-3">Name</th>
                        <th class="py-3">Email</th>
                        <th class="py-3">Department</th>
                        <th class="py-3">Job Title</th>
                        <th class="py-3">Clock No.</th>
                        <th class="py-3"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="px-4 py-3">
                                <div style="font-weight:600;">@user.FullName</div>
                                @if (user.IsManager)
                                {
                                    <span class="badge bg-success" style="font-size:.7rem;">Manager</span>
                                }
                            </td>
                            <td class="py-3" style="font-size:.875rem;color:#64748b;">@user.Email</td>
                            <td class="py-3" style="color:#64748b;">@(user.Department ?? "-")</td>
                            <td class="py-3" style="color:#64748b;">@(user.JobTitle ?? "-")</td>
                            <td class="py-3" style="color:#64748b;">@(user.ClockNumber?.ToString() ?? "-")</td>
                            <td class="py-3">
                                <a asp-action="EmployeeLeaveHistory"
                                asp-route-employeeId="@user.Id"
                                class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye me-1"></i> View History
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5" style="color:#94a3b8;">
                <i class="bi bi-search" style="font-size:2rem;"></i>
                @if (!string.IsNullOrEmpty(ViewBag.Search as string) || !string.IsNullOrEmpty(ViewBag.SelectedDept as string))
                {
                    <p class="mt-2 mb-1">No employees found matching your search.</p>
                    <a asp-action="LeaveHistory" class="btn btn-outline-secondary btn-sm mt-2">Clear Search</a>
                }
                else
                {
                    <p class="mt-2 mb-0">No employees found.</p>
                }
            </div>
        }
    </div>
</div>

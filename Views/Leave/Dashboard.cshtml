@model HR_Portal.ViewModel.UserViewModels.UserDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

@* ── Stat row ────────────────────────────────────────────────────────────── *@
<div class="row g-3 mb-4">
    @foreach (var b in Model.Balances)
    {
        var pct = b.TotalDays > 0 ? (double)b.RemainingDays / (double)b.TotalDays * 100 : 0;
        var barClass = pct > 50 ? "bar-good" : pct > 20 ? "bar-warn" : "bar-low";
        <div class="col-sm-6 col-lg-3">
            <div class="card p-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span style="font-size:.8125rem;font-weight:600;color:#64748b;">@b.LeaveTypeName</span>
                    <span style="font-size:1.5rem;font-weight:700;color:#2563EB;">@b.RemainingDays</span>
                </div>
                <div class="balance-bar-track mb-1">
                    <div class="balance-bar @barClass" style="width:@pct.ToString("F0")%"></div>
                </div>
                <div class="d-flex justify-content-between" style="font-size:.75rem;color:#94a3b8;">
                    <span>@b.UsedDays used</span>
                    <span>@b.TotalDays total</span>
                </div>
                @if (b.PendingDays > 0)
                {
                    <div style="font-size:.75rem;color:#D97706;margin-top:.2rem;">@b.PendingDays pending</div>
                }
            </div>
        </div>
    }
</div>

<div class="row g-3">
    @* ── Recent requests ───────────────────────────────────────────────── *@
    <div class="col-lg-@(Model.IsManager ? "7" : "12")">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-clock-history me-2"></i>Recent Requests</span>
                <a asp-action="Apply" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus"></i> Apply
                </a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentRequests.Any())
                {
                    <table class="table table-hover mb-0">
                        <thead style="background:#f8fafc;font-size:.8125rem;color:#64748b;">
                            <tr>
                                <th class="px-4 py-3">Leave Type</th>
                                <th class="py-3">Dates</th>
                                <th class="py-3">Days</th>
                                <th class="py-3">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.RecentRequests)
                            {
                                <tr>
                                    <td class="px-4 py-3" style="font-weight:500;">@r.LeaveType.Name</td>
                                    <td class="py-3" style="font-size:.875rem;color:#64748b;">
                                        @r.StartDate.ToString("dd MMM") – @r.EndDate.ToString("dd MMM yyyy")
                                    </td>
                                    <td class="py-3">@r.TotalDays</td>
                                    <td class="py-3">
                                        <span class="status-badge status-@r.Status.ToString().ToLower()">
                                            @r.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-center py-5" style="color:#94a3b8;">
                        <i class="bi bi-inbox" style="font-size:2rem;"></i>
                        <p class="mt-2 mb-0">No leave requests yet</p>
                        <a asp-action="Apply" class="btn btn-primary btn-sm mt-3">Apply for Leave</a>
                    </div>
                }
            </div>
        </div>
    </div>

    @* ── Pending team requests (managers only) ─────────────────────────── *@
    @if (Model.IsManager)
    {
        <div class="col-lg-5">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-people me-2"></i>Pending Team Requests</span>
                    @if (Model.PendingTeamCount > 0)
                    {
                        <span class="badge bg-danger">@Model.PendingTeamCount</span>
                    }
                </div>
                <div class="card-body p-0">
                    @if (Model.PendingTeamRequests.Any())
                    {
                        <table class="table table-hover mb-0">
                            <thead style="background:#f8fafc;font-size:.8125rem;color:#64748b;">
                                <tr>
                                    <th class="px-4 py-3">Employee</th>
                                    <th class="py-3">Type</th>
                                    <th class="py-3">Days</th>
                                    <th class="py-3"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.PendingTeamRequests)
                                {
                                    <tr>
                                        <td class="px-4 py-3" style="font-weight:500;">
                                            @r.Employee.Name @r.Employee.Surname
                                        </td>
                                        <td class="py-3" style="font-size:.875rem;color:#64748b;">@r.LeaveType.Name</td>
                                        <td class="py-3">@r.TotalDays</td>
                                        <td class="py-3">
                                            <a asp-action="ReviewRequest" asp-route-id="@r.Id"
                                               class="btn btn-sm btn-outline-primary">Review</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="text-center py-5" style="color:#94a3b8;">
                            <i class="bi bi-check-circle" style="font-size:2rem;color:#16A34A;"></i>
                            <p class="mt-2 mb-0">No pending requests</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>
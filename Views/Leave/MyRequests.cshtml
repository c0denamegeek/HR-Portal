@model HR_Portal.ViewModel.LeaveViewModels.LeaveRequestListViewModel
@{
    ViewData["Title"] = "My Requests";
}

@* ── Balances ─────────────────────────────────────────────────────────────── *@
<div class="row g-3 mb-4">
    @foreach (var b in Model.Balances)
    {
        var pct = b.TotalDays > 0 ? (double)b.RemainingDays / (double)b.TotalDays * 100 : 0;
        var barClass = pct > 50 ? "bar-good" : pct > 20 ? "bar-warn" : "bar-low";
        <div class="col-sm-6 col-lg-3">
            <div class="card p-3">
                <div class="d-flex justify-content-between mb-1">
                    <span style="font-size:.8rem;font-weight:600;color:#64748b;">@b.LeaveTypeName</span>
                    <span style="font-weight:700;color:#2563EB;">@b.RemainingDays</span>
                </div>
                <div class="balance-bar-track">
                    <div class="balance-bar @barClass" style="width:@pct.ToString("F0")%"></div>
                </div>
            </div>
        </div>
    }
</div>

@* ── Filters + table ─────────────────────────────────────────────────────── *@
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span><i class="bi bi-clock-history me-2"></i>Leave History</span>
        <div class="d-flex gap-2 flex-wrap">
            <form method="get" class="d-flex gap-2 flex-wrap">
                <select name="status" class="form-select form-select-sm" style="width:auto;"
                        onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    @foreach (var s in Enum.GetValues<HR_Portal.Models.Enums.LeaveStatus>())
                    {
                        <option value="@s" selected="@(Model.StatusFilter == s)">@s</option>
                    }
                </select>
                <select name="year" class="form-select form-select-sm" style="width:auto;"
                        onchange="this.form.submit()">
                    @for (int y = DateTime.Today.Year; y >= DateTime.Today.Year - 3; y--)
                    {
                        <option value="@y" selected="@(Model.SelectedYear == y)">@y</option>
                    }
                </select>
            </form>
            <a asp-action="Apply" class="btn btn-primary btn-sm">
                <i class="bi bi-plus"></i> Apply
            </a>
        </div>
    </div>

    <div class="card-body p-0">
        @if (Model.Requests.Any())
        {
            <table class="table table-hover mb-0">
                <thead style="background:#f8fafc;font-size:.8125rem;color:#64748b;">
                    <tr>
                        <th class="px-4 py-3">Leave Type</th>
                        <th class="py-3">Start</th>
                        <th class="py-3">End</th>
                        <th class="py-3">Days</th>
                        <th class="py-3">Status</th>
                        <th class="py-3">Reviewer</th>
                        <th class="py-3">Submitted</th>
                        <th class="py-3"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Requests)
                    {
                        <tr>
                            <td class="px-4 py-3" style="font-weight:500;">@r.LeaveType.Name</td>
                            <td class="py-3">@r.StartDate.ToString("dd MMM yyyy")</td>
                            <td class="py-3">@r.EndDate.ToString("dd MMM yyyy")</td>
                            <td class="py-3">@r.TotalDays</td>
                            <td class="py-3">
                                <span class="status-badge status-@r.Status.ToString().ToLower()">@r.Status</span>
                            </td>
                            <td class="py-3" style="font-size:.875rem;color:#64748b;">
                                @(r.Approver is not null ? $"{r.Approver.Name} {r.Approver.Surname}" : "HR Admin")
                            </td>
                            <td class="py-3" style="font-size:.875rem;color:#64748b;">
                                @r.CreatedAt.ToString("dd MMM yyyy")
                            </td>
                            <td class="py-3">
                                @if (r.CanBeCancelled)
                                {
                                    <form asp-action="Cancel" asp-route-id="@r.Id" method="post"
                                          onsubmit="return confirm('Cancel this leave request?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5" style="color:#94a3b8;">
                <i class="bi bi-inbox" style="font-size:2rem;"></i>
                <p class="mt-2 mb-0">No requests found</p>
            </div>
        }
    </div>
</div>

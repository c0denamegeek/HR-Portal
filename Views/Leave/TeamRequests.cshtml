@model IEnumerable<HR_Portal.Models.Domain.LeaveRequest>
@{
    ViewData["Title"] = "Team Requests";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-people me-2"></i>Pending Team Requests</span>
        @if (Model.Any())
        {
            <span class="badge bg-danger">@Model.Count() pending</span>
        }
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <table class="table table-hover mb-0">
                <thead style="background:#f8fafc;font-size:.8125rem;color:#64748b;">
                    <tr>
                        <th class="px-4 py-3">Employee</th>
                        <th class="py-3">Leave Type</th>
                        <th class="py-3">Start</th>
                        <th class="py-3">End</th>
                        <th class="py-3">Days</th>
                        <th class="py-3">Submitted</th>
                        <th class="py-3">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="px-4 py-3">
                                <div style="font-weight:600;">@r.Employee.Name @r.Employee.Surname</div>
                                <div style="font-size:.8rem;color:#94a3b8;">@r.Employee.Department</div>
                            </td>
                            <td class="py-3">@r.LeaveType.Name</td>
                            <td class="py-3">@r.StartDate.ToString("dd MMM yyyy")</td>
                            <td class="py-3">@r.EndDate.ToString("dd MMM yyyy")</td>
                            <td class="py-3">@r.TotalDays</td>
                            <td class="py-3" style="font-size:.875rem;color:#64748b;">
                                @r.CreatedAt.ToString("dd MMM yyyy")
                            </td>
                            <td class="py-3">
                                <a asp-action="ReviewRequest" asp-route-id="@r.Id"
                                   class="btn btn-sm btn-primary">
                                    <i class="bi bi-eye me-1"></i> Review
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5" style="color:#94a3b8;">
                <i class="bi bi-check-circle" style="font-size:2.5rem;color:#16A34A;"></i>
                <p class="mt-2 mb-0 fw-semibold">All caught up!</p>
                <p style="font-size:.875rem;">No pending requests from your team.</p>
            </div>
        }
    </div>
</div>

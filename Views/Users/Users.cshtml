@model IEnumerable<HR_Portal.Models.Users>
@{
    ViewData["Title"] = "Manage Users";
    var userRoles = (Dictionary<string, string>)ViewBag.UserRoles;
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-people me-2"></i>Users</span>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus me-1"></i> Add User
        </a>
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <table class="table table-hover mb-0">
                <thead style="background:#f8fafc;font-size:.8125rem;color:#64748b;">
                    <tr>
                        <th class="px-4 py-3">Name</th>
                        <th class="py-3">Email</th>
                        <th class="py-3">Clock No.</th>
                        <th class="py-3">Department</th>
                        <th class="py-3">Job Title</th>
                        <th class="py-3">Manager</th>
                        <th class="py-3">Role</th>
                        <th class="py-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        var role = userRoles.ContainsKey(user.Id) ? userRoles[user.Id] : "User";
                        <tr>
                            <td class="px-4 py-3">
                                <div style="font-weight:600;">@user.FullName</div>
                                @if (user.IsManager)
                                {
                                    <span class="badge bg-success" style="font-size:.7rem;">Manager</span>
                                }
                            </td>
                            <td class="py-3" style="font-size:.875rem;color:#64748b;">@user.Email</td>
                            <td class="py-3" style="color:#64748b;">@(user.ClockNumber?.ToString() ?? "-")</td>
                            <td class="py-3" style="color:#64748b;">@(user.Department ?? "-")</td>
                            <td class="py-3" style="color:#64748b;">@(user.JobTitle ?? "-")</td>
                            <td class="py-3" style="font-size:.875rem;color:#64748b;">
                                @(user.Manager is not null ? user.Manager.FullName : "-")
                            </td>
                            <td class="py-3">
                                <span class="badge @(role == "Admin" ? "bg-primary" : "bg-secondary")">@role</span>
                            </td>
                            <td class="py-3">
                                <div class="d-flex gap-1">
                                    <a asp-action="EditUser" asp-route-id="@user.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <form asp-action="Deactivate" asp-route-id="@user.Id" method="post"
                                          onsubmit="return confirm('Deactivate @user.FullName?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-person-x"></i> Deactivate
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5" style="color:#94a3b8;">
                <i class="bi bi-people" style="font-size:2rem;"></i>
                <p class="mt-2 mb-1">No users found.</p>
                <a asp-action="Create" class="btn btn-primary btn-sm mt-2">Add First User</a>
            </div>
        }
    </div>
</div>

